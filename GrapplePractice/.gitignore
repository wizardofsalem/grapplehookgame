# ---------- Unreal Engine build output ----------
# All regenerated by UnrealBuildTool / the editor. Never commit.
Binaries/
Intermediate/
Build/
DerivedDataCache/

# Logs, autosaves, crash reports, per-user editor config
Saved/

# Plugin build output. Plugin Source/ and Content/ are still tracked.
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ---------- IDE / toolchain ----------
# Solution and project files are regenerated from the .uproject
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.user
*.xcodeproj/
*.xcworkspace/
.vs/
.vsconfig
.idea/
.vscode/

# ---------- OS noise ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- Deliberately tracked ----------
# Content/    your .uasset / .umap files are the game
# Config/     project settings
# Source/     C++ and Build.cs / Target.cs
# *.uproject  project descriptor
